            <size value="620px 34px" />
        </Profile>

        <Profile name="aoBuchKachelLabel" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="280px" /><textSize value="15px" />
            <textColor value="$preset_fs25_colorGrey" />
        </Profile>
        <Profile name="aoBuchKachelWert" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="280px" /><textSize value="24px" /><textBold value="true" />
        </Profile>

        <Profile name="aoBuchSektion" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="420px" /><textSize value="16px" /><textBold value="true" />
        </Profile>

        <Profile name="aoBuchRangLabel" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="230px" /><textSize value="15px" /><textAlignment value="right" />
        </Profile>
        <!-- Volle Breite ist das Maximum, die Mod kuerzt zur Laufzeit.
             Die Textur wird in onOpen gesetzt (images/white.dds), sonst zeigt
             das Element ein Stueck der UI-Textur. -->
        <Profile name="aoBuchBalken" extends="baseReference" with="anchorTopLeft">
            <size value="220px 18px" />
            <imageUVs value="0 0 1 1" />
            <imageColor value="0.165 0.471 0.839 1" />
            <imageSliceId value="noSlice" />
        </Profile>
        <Profile name="aoBuchRangWert" extends="fs25_textDefault" with="anchorTopLeft">
